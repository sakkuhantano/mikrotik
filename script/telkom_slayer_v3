# =================================================
# TELKOM SLAYER V3 - STABILITY FIRST
# RouterOS 7.x | Scheduler: every 1 minute
#
# Policy:
# - Public IP: keep connection; update DDNS only if IP changes.
# - Private IP + internet reachable: do not disconnect for 10 minutes.
# - At 10 minutes: one controlled reconnect only.
# - After 3 failed private-IP reconnect cycles: one MAC rotation.
# - PPPoE no-IP freeze: three fast reconnect cycles (5s IP wait each), then MAC rotation (15s IP wait).
# - After MAC rotation: preserve a working connection; no-IP retries cool down 5m.
# - Internet outage: one reconnect per recovery cycle with a 2-minute retry interval.
# - External reachability: either 1.1.1.1 OR 8.8.8.8 replying is sufficient.
# - One execution at a time; detailed stage logging for diagnosis.
# =================================================

:local pppoeName "Telkom"
:local wanIf "ether1"
:local macPrefix "02"

# =================================================
# GLOBAL STATE
# =================================================
:global slayerV3Running
:global slayerV3MacRotateCount
:global slayerV3LastRandomMAC
:global slayerV3ReconnectFailures
:global slayerV3NoIPFailures
:global slayerV3PrivateTicks
:global slayerV3OutageCooldown
:global slayerV3LastPublicIP
:global slayerV3LastLoggedInternetIP
:global slayerV3Stage

:if ([:typeof $slayerV3Running] = "nothing") do={ :set slayerV3Running false }
:if ([:typeof $slayerV3MacRotateCount] = "nothing") do={ :set slayerV3MacRotateCount 0 }
:if ([:typeof $slayerV3LastRandomMAC] = "nothing") do={ :set slayerV3LastRandomMAC "" }
:if ([:typeof $slayerV3ReconnectFailures] = "nothing") do={ :set slayerV3ReconnectFailures 0 }
:if ([:typeof $slayerV3NoIPFailures] = "nothing") do={ :set slayerV3NoIPFailures 0 }
:if ([:typeof $slayerV3PrivateTicks] = "nothing") do={ :set slayerV3PrivateTicks 0 }
:if ([:typeof $slayerV3OutageCooldown] = "nothing") do={ :set slayerV3OutageCooldown 0 }
:if ([:typeof $slayerV3LastPublicIP] = "nothing") do={ :set slayerV3LastPublicIP "" }
:if ([:typeof $slayerV3LastLoggedInternetIP] = "nothing") do={ :set slayerV3LastLoggedInternetIP "" }
:if ([:typeof $slayerV3Stage] = "nothing") do={ :set slayerV3Stage "INITIALIZATION" }

# =================================================
# LOCK
# =================================================
:if ($slayerV3Running = true) do={

    :return
}
:set slayerV3Running true
:set slayerV3Stage "START / LOCK ACQUIRED"


:onerror slayerV3Error in={

    # -------------------------------------------------
    # GET PPPoE IP
    # -------------------------------------------------
    :local getIP do={
        :global slayerV3Stage
        :set slayerV3Stage "READ PPPoE IP ADDRESS"
        :local ppp $1
        :local ids [/ip address find interface=$ppp]
        :if ([:len $ids] = 0) do={ :return "" }
        :local addr [/ip address get [:pick $ids 0] address]
        :local slash [:find $addr "/"]
        :if ($slash != nil) do={ :return [:pick $addr 0 $slash] }
        :return $addr
    }

    # -------------------------------------------------
    # CLASSIFY IPv4
    # -------------------------------------------------
    :local classifyIP do={
        :local ip $1
        :if ([:len $ip] = 0) do={ :return "DEAD" }
        :if ($ip ~ "^10\\.") do={ :return "PRIVATE" }
        :if ($ip ~ "^192\\.168\\.") do={ :return "PRIVATE" }
        :if ($ip ~ "^172\\.(1[6-9]|2[0-9]|3[0-1])\\.") do={ :return "PRIVATE" }
        :if ($ip ~ "^100\\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.") do={ :return "PRIVATE" }
        :if ($ip ~ "^(0|127|169)\\.") do={ :return "PRIVATE" }
        :if ($ip ~ "^192\\.0\\.0\\.") do={ :return "PRIVATE" }
        :if ($ip ~ "^192\\.0\\.2\\.") do={ :return "PRIVATE" }
        :if ($ip ~ "^192\\.88\\.99\\.") do={ :return "PRIVATE" }
        :if ($ip ~ "^198\\.(18|19)\\.") do={ :return "PRIVATE" }
        :if ($ip ~ "^198\\.51\\.100\\.") do={ :return "PRIVATE" }
        :if ($ip ~ "^203\\.0\\.113\\.") do={ :return "PRIVATE" }
        :if ($ip ~ "^(22[4-9]|23[0-9]|24[0-9]|25[0-5])\\.") do={ :return "PRIVATE" }
        :return "PUBLIC"
    }

    # -------------------------------------------------
    # TEST INTERNET REACHABILITY
    # -------------------------------------------------
    :local probeInternet do={
        :global slayerV3Stage
        :set slayerV3Stage "INTERNET PROBE: ping 1.1.1.1"
        :local p1 [/ping address=1.1.1.1 count=2]
        :set slayerV3Stage "INTERNET PROBE: ping 8.8.8.8"
        :local p2 [/ping address=8.8.8.8 count=2]
        # Probe details are intentionally omitted to keep the system log quiet.
        :if (($p1 > 0) || ($p2 > 0)) do={ :return true }
        :return false
    }

    # -------------------------------------------------
    # ONE CONTROLLED PPPoE RECONNECT
    # -------------------------------------------------
    :local reconnect do={
        :global slayerV3Stage
        :local ppp $1
        :local waitSeconds 60
        :if ([:len $2] > 0) do={ :set waitSeconds $2 }
        :local waitChecks ($waitSeconds * 2)
        :log warning ("SLAYER V3: Starting one controlled reconnect for " . $ppp . "; IP wait=" . $waitSeconds . " seconds.")
        :local pids [/interface pppoe-client find name=$ppp]
        :if ([:len $pids] = 0) do={
            :log error ("SLAYER V3: PPPoE client not found: " . $ppp)
            :return "DEAD"
        }

        :set slayerV3Stage ("RECONNECT: disable PPPoE " . $ppp)
        /interface pppoe-client disable $pids
        :local isDown false
        :for n from=1 to=10 do={
            :if ($isDown = false) do={
                :if ([/interface pppoe-client get [:pick $pids 0] running] = false) do={
                    :set isDown true
                } else={
                    :delay 300ms
                }
            }
        }
        :if ($isDown = false) do={
            :log error "SLAYER V3: PPPoE did not stop within 3 seconds; restoring enable state."
            :set slayerV3Stage ("RECONNECT: re-enable after BUSY " . $ppp)
            /interface pppoe-client enable $pids
            :return "BUSY"
        }

        :set slayerV3Stage ("RECONNECT: enable PPPoE " . $ppp)
        /interface pppoe-client enable $pids
        :set slayerV3Stage ("RECONNECT: wait up to " . $waitSeconds . " seconds for IP " . $ppp)
        :for n from=1 to=$waitChecks do={
            :local ip [$getIP $ppp]
            :if ([:len $ip] > 0) do={
                :local state [$classifyIP $ip]
                :log warning ("SLAYER V3: Reconnect result IP=" . $ip . " state=" . $state)
                :return $state
            }
            :delay 500ms
        }
        :log error ("SLAYER V3: No PPPoE IP after " . $waitSeconds . " seconds.")
        :return "DEAD"
    }

    # -------------------------------------------------
    # ONE MAC ROTATION
    # -------------------------------------------------
    :local rotateMAC do={
        :global slayerV3Stage
        :global slayerV3MacRotateCount
        :global slayerV3LastRandomMAC
        :local iface $1
        :local ppp $2
        :local prefix $3
        :local waitSeconds 20
        :if ([:len $4] > 0) do={ :set waitSeconds $4 }
        :local waitChecks ($waitSeconds * 2)
        :local eids [/interface ethernet find name=$iface]
        :if ([:len $eids] = 0) do={
            :log error ("SLAYER V3: Ethernet interface not found: " . $iface)
            :return "DEAD"
        }
        :local pids [/interface pppoe-client find name=$ppp]
        :if ([:len $pids] = 0) do={
            :log error ("SLAYER V3: PPPoE client not found: " . $ppp)
            :return "DEAD"
        }

        :set slayerV3Stage ("MAC ROTATION: disable PPPoE " . $ppp)
        /interface pppoe-client disable $pids
        :local isDown false
        :for n from=1 to=10 do={
            :if ($isDown = false) do={
                :if ([/interface pppoe-client get [:pick $pids 0] running] = false) do={
                    :set isDown true
                } else={
                    :delay 300ms
                }
            }
        }
        :if ($isDown = false) do={
            :log error "SLAYER V3: Cannot rotate MAC; PPPoE did not stop."
            :set slayerV3Stage ("MAC ROTATION: re-enable after BUSY " . $ppp)
            /interface pppoe-client enable $pids
            :return "BUSY"
        }

        :if ($slayerV3MacRotateCount < 10) do={
            :local rnd [:rndstr from="0123456789ABCDEF" length=10]
            :local newMac ("02:" . [:pick $rnd 0 2] . ":" . [:pick $rnd 2 4] . ":" . [:pick $rnd 4 6] . ":" . [:pick $rnd 6 8] . ":" . [:pick $rnd 8 10])
            :if ($newMac = $slayerV3LastRandomMAC) do={
                :set rnd [:rndstr from="0123456789ABCDEF" length=10]
                :set newMac ("02:" . [:pick $rnd 0 2] . ":" . [:pick $rnd 2 4] . ":" . [:pick $rnd 4 6] . ":" . [:pick $rnd 6 8] . ":" . [:pick $rnd 8 10])
            }
            :set slayerV3LastRandomMAC $newMac
            :set slayerV3MacRotateCount ($slayerV3MacRotateCount + 1)
            :log warning ("SLAYER V3: Applying random locally-administered MAC #" . $slayerV3MacRotateCount . "/10 -> " . $newMac)
            :set slayerV3Stage ("MAC ROTATION: set random MAC " . $newMac)
            /interface ethernet set [:pick $eids 0] mac-address=$newMac
        } else={
            :log warning "SLAYER V3: Ten random MAC attempts used; restoring factory MAC."
            :set slayerV3Stage ("MAC ROTATION: reset hardware MAC on " . $iface)
            /interface ethernet reset-mac-address [:pick $eids 0]
            :set slayerV3MacRotateCount 0
            :set slayerV3LastRandomMAC ""
        }

        :set slayerV3Stage ("MAC ROTATION: enable PPPoE " . $ppp)
        /interface pppoe-client enable $pids
        :set slayerV3Stage ("MAC ROTATION: wait up to " . $waitSeconds . " seconds for IP " . $ppp)
        :for n from=1 to=$waitChecks do={
            :local ip [$getIP $ppp]
            :if ([:len $ip] > 0) do={
                :local state [$classifyIP $ip]
                :log warning ("SLAYER V3: After MAC rotation IP=" . $ip . " state=" . $state)
                :return $state
            }
            :delay 500ms
        }
        :log error ("SLAYER V3: No PPPoE IP after MAC rotation (" . $waitSeconds . " seconds).")
        :return "DEAD"
    }

    # =================================================
    # MAIN
    # =================================================
    :set slayerV3Stage "MAIN: find WAN Ethernet interface"
    :local wanIds [/interface ethernet find name=$wanIf]
    :if ([:len $wanIds] = 0) do={
        :log error ("SLAYER V3: WAN interface not found: " . $wanIf)
    } else={
        :local wanRunning [/interface ethernet get [:pick $wanIds 0] running]
        :if ($wanRunning = false) do={

            :set slayerV3PrivateTicks 0
        } else={
            :local currentIP [$getIP $pppoeName]
            :local state [$classifyIP $currentIP]


            :if ($state = "PUBLIC") do={
                :set slayerV3Stage "MAIN: verify public-IP internet reachability"
                :local internetOK [$probeInternet]
                :if (($internetOK = true) && ($currentIP != $slayerV3LastLoggedInternetIP)) do={
                    :log info ("SLAYER V3: Internet detected; PPPoE IP=" . $currentIP . " (PUBLIC)")
                    :set slayerV3LastLoggedInternetIP $currentIP
                }
                :set slayerV3PrivateTicks 0
                :set slayerV3ReconnectFailures 0
                :set slayerV3NoIPFailures 0
                :set slayerV3OutageCooldown 0
                :if ($currentIP != $slayerV3LastPublicIP) do={
                    :log warning ("SLAYER V3: Public IP changed -> " . $currentIP)
                    :set slayerV3Stage ("DDNS: update for public IP " . $currentIP)
                    /system script run update_ddns
                    :set slayerV3LastPublicIP $currentIP
                }
            } else={
                :set slayerV3Stage "MAIN: external internet reachability probe"
                :local internetOK [$probeInternet]

                :if ($state = "PRIVATE") do={
                    :set slayerV3NoIPFailures 0
                    :if ($internetOK = true) do={
                        :if ($currentIP != $slayerV3LastLoggedInternetIP) do={
                            :log info ("SLAYER V3: Internet detected; PPPoE IP=" . $currentIP . " (PRIVATE)")
                            :set slayerV3LastLoggedInternetIP $currentIP
                        }
                        :set slayerV3OutageCooldown 0
                        :set slayerV3PrivateTicks ($slayerV3PrivateTicks + 1)

                        :if ($slayerV3PrivateTicks >= 10) do={
                            :set slayerV3PrivateTicks 0
                            :log warning "SLAYER V3: 10-minute private-IP interval reached; starting exactly one reconnect cycle."
                            :local result [$reconnect $pppoeName]
                            :if ($result = "PUBLIC") do={
                                :set slayerV3ReconnectFailures 0
                                :set slayerV3OutageCooldown 0
                                :local newIP [$getIP $pppoeName]
                                :if ($newIP != $slayerV3LastPublicIP) do={
                                    :set slayerV3Stage ("DDNS: update after reconnect; public IP " . $newIP)
                                    /system script run update_ddns
                                    :set slayerV3LastPublicIP $newIP
                                }
                            } else={
                                :if ($result = "PRIVATE") do={
                                    :set slayerV3ReconnectFailures ($slayerV3ReconnectFailures + 1)
                                    :log warning ("SLAYER V3: Reconnect cycle failed to obtain public IP; consecutive failures=" . $slayerV3ReconnectFailures . "/3. Keeping current connection.")
                                    :set slayerV3Stage "POST-RECONNECT: verify internet"
                                    :local postProbe [$probeInternet]
                                    :if ($postProbe = false) do={
                                        :log warning "SLAYER V3: Internet probe failed after reconnect; outage recovery will be rate-limited."
                                        :set slayerV3OutageCooldown 2
                                    }
                                    :if ($slayerV3ReconnectFailures >= 3) do={
                                        :log warning "SLAYER V3: Three private-IP reconnect cycles failed; one MAC rotation is now permitted."
                                        :local macResult [$rotateMAC $wanIf $pppoeName $macPrefix]
                                        :if ($macResult = "PUBLIC") do={
                                            :set slayerV3ReconnectFailures 0
                                            :local newIP [$getIP $pppoeName]
                                            :if ($newIP != $slayerV3LastPublicIP) do={
                                                :set slayerV3Stage ("DDNS: update after MAC rotation; public IP " . $newIP)
                                                /system script run update_ddns
                                                :set slayerV3LastPublicIP $newIP
                                            }
                                        } else={
                                            :if ($macResult = "PRIVATE") do={
                                                :set slayerV3ReconnectFailures 0
                                                :set slayerV3PrivateTicks 0
                                                :log warning "SLAYER V3: MAC rotation still returned private IP; preserving connection and restarting 30-minute interval."
                                            } else={
                                                :log error "SLAYER V3: MAC rotation did not restore PPPoE; outage recovery cooldown applied."
                                                :set slayerV3OutageCooldown 2
                                            }
                                        }
                                    }
                                } else={
                                    :if ($result = "BUSY") do={
                                        :log warning "SLAYER V3: Reconnect skipped because PPPoE did not stop cleanly."
                                    } else={
                                        :log error "SLAYER V3: Reconnect did not obtain an IP; outage cooldown applied."
                                        :set slayerV3OutageCooldown 2
                                    }
                                }
                            }
                        }
                    } else={

                        :if ($slayerV3OutageCooldown > 0) do={
                            :set slayerV3OutageCooldown ($slayerV3OutageCooldown - 1)

                        } else={
                            :log warning "SLAYER V3: Internet appears unreachable; one outage reconnect attempt."
                            :local result [$reconnect $pppoeName]
                            :if ($result = "PUBLIC") do={
                                :set slayerV3ReconnectFailures 0
                                :set slayerV3PrivateTicks 0
                                :local newIP [$getIP $pppoeName]
                                :if ($newIP != $slayerV3LastPublicIP) do={
                                    :set slayerV3Stage ("DDNS: update after outage recovery; public IP " . $newIP)
                                    /system script run update_ddns
                                    :set slayerV3LastPublicIP $newIP
                                }
                            } else={
                                :if ($result = "PRIVATE") do={
                                    :set slayerV3Stage "OUTAGE RECOVERY: verify internet after reconnect"
                                    :local postProbe [$probeInternet]
                                    :if ($postProbe = true) do={
                                        :set slayerV3ReconnectFailures ($slayerV3ReconnectFailures + 1)
                                        :set slayerV3PrivateTicks 0
                                        :log warning ("SLAYER V3: Internet restored with private IP; preserving connection. Failed public-IP cycles=" . $slayerV3ReconnectFailures . "/3.")
                                    } else={
                                        :set slayerV3OutageCooldown 2
                                        :log error "SLAYER V3: PPPoE has private IP but internet probes still fail; retry in 2 minutes."
                                    }
                                } else={
                                    :set slayerV3OutageCooldown 2
                                    :log error "SLAYER V3: PPPoE still has no usable IP; retry in 2 minutes."
                                }
                            }
                        }
                    }
                } else={
                    # PPPoE has no IP: three failed cycles trigger MAC rotation.
                    :if ($slayerV3OutageCooldown > 0) do={
                        :set slayerV3OutageCooldown ($slayerV3OutageCooldown - 1)

                    } else={
                        :log warning ("SLAYER V3: PPPoE has no IP; controlled reconnect attempt. No-IP failure cycles=" . $slayerV3NoIPFailures . "/3.")
                        :local result [$reconnect $pppoeName 5]
                        :if ($result = "PUBLIC") do={
                            :set slayerV3NoIPFailures 0
                            :set slayerV3ReconnectFailures 0
                            :set slayerV3PrivateTicks 0
                            :set slayerV3OutageCooldown 0
                            :local newIP [$getIP $pppoeName]
                            :if ($newIP != $slayerV3LastPublicIP) do={
                                :set slayerV3Stage ("DDNS: update after no-IP recovery; public IP " . $newIP)
                                /system script run update_ddns
                                :set slayerV3LastPublicIP $newIP
                            }
                        } else={
                            :if ($result = "PRIVATE") do={
                                :set slayerV3NoIPFailures 0
                                :set slayerV3PrivateTicks 0
                                :set slayerV3ReconnectFailures ($slayerV3ReconnectFailures + 1)
                                :set slayerV3Stage "NO-IP RECOVERY: verify internet after reconnect"
                                :local postProbe [$probeInternet]
                                :if ($postProbe = true) do={
                                    :log warning ("SLAYER V3: PPPoE recovered with private IP; internet works. Public-IP failure cycles=" . $slayerV3ReconnectFailures . "/3.")
                                } else={
                                    :set slayerV3OutageCooldown 2
                                    :log error "SLAYER V3: PPPoE got private IP but internet remains unreachable; retry in 2 minutes."
                                }
                            } else={
                                :if ($result = "BUSY") do={
                                    :log warning "SLAYER V3: No-IP reconnect skipped because PPPoE did not stop cleanly; not counted as a failed cycle."
                                } else={
                                    :set slayerV3NoIPFailures ($slayerV3NoIPFailures + 1)
                                    :log error ("SLAYER V3: PPPoE still has no IP after reconnect. No-IP failure cycles=" . $slayerV3NoIPFailures . "/3.")
                                    :if ($slayerV3NoIPFailures >= 3) do={
                                        :log warning "SLAYER V3: Three consecutive no-IP recovery cycles failed; initiating MAC rotation."
                                        :local macResult [$rotateMAC $wanIf $pppoeName $macPrefix 15]
                                        :if (($macResult = "PUBLIC") || ($macResult = "PRIVATE")) do={
                                            :set slayerV3NoIPFailures 0
                                            :set slayerV3OutageCooldown 0
                                            :set slayerV3PrivateTicks 0
                                            :if ($macResult = "PUBLIC") do={
                                                :set slayerV3ReconnectFailures 0
                                                :local newIP [$getIP $pppoeName]
                                                :if ($newIP != $slayerV3LastPublicIP) do={
                                                    :set slayerV3Stage ("DDNS: update after no-IP MAC rotation; public IP " . $newIP)
                                                    /system script run update_ddns
                                                    :set slayerV3LastPublicIP $newIP
                                                }
                                            } else={
                                                :set slayerV3ReconnectFailures ($slayerV3ReconnectFailures + 1)
                                                :log warning "SLAYER V3: MAC rotation restored a private IP; preserving the connection."
                                            }
                                        } else={
                                            :set slayerV3NoIPFailures 0
                                            :set slayerV3OutageCooldown 5
                                            :log error ("SLAYER V3: MAC rotation #" . $slayerV3MacRotateCount . " failed; cooldown 5 minutes, then start a fresh three-cycle reconnect window.")
                                        }
                                    } else={
                                        :set slayerV3OutageCooldown 2
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

} do={
    :log error ("SLAYER V3: Runtime error at stage [" . $slayerV3Stage . "] -> " . $slayerV3Error)
}

# =================================================
# UNLOCK
# =================================================
:set slayerV3Stage "UNLOCK"
:set slayerV3Running false

